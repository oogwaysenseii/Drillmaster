# Copy to .env.local and fill in.

# Google Maps JavaScript API key, used by the service-area map.
#
# ⚠️  This value is embedded in the client bundle and is PUBLICLY VISIBLE —
#     that is unavoidable for the Maps JS API. Secure it in Google Cloud
#     Console instead:
#       1. APIs & Services → Credentials → your key → Application restrictions
#       2. Set "Websites" and allow ONLY:  https://drillmaster.sk/*
#          (add http://localhost:3000/* for local development)
#       3. API restrictions → allow only "Maps JavaScript API"
#       4. Set a billing budget + alert on the project
#     Without a referrer restriction anyone can copy the key and bill it to you.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------------
# Resend — delivers the contact form to the inbox.
#
# ⚠️  This one IS a real secret. It has no NEXT_PUBLIC_ prefix, so it stays on
#     the server and never reaches the browser. Keep it out of git: it belongs
#     in .env.local locally and in Vercel's Environment Variables in production.
RESEND_API_KEY=

# Optional overrides. `CONTACT_FROM` must be on a domain verified in Resend —
# until drillmaster.sk finishes DNS verification, set it to onboarding@resend.dev
# to test the whole path end to end.
# CONTACT_FROM=DrillMaster Web <web@drillmaster.sk>
# CONTACT_TO=drillmaster@mnsp.sk
