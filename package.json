{
  "name": "drillmaster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true});console.log('removed .next')\"",
    "reset": "node -e \"const f=require('fs');['.next','node_modules'].forEach(d=>f.rmSync(d,{recursive:true,force:true}));console.log('removed .next + node_modules')\" && npm install && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
